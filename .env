# ─────────────────────────────────────────────────────────────────────────────
# We Care Car Care (car-care) — environment
# ─────────────────────────────────────────────────────────────────────────────
# This file is gitignored (see .gitignore). Copy from .env.example:
#   cp .env.example .env
# Never commit secrets or customer PII.
# ─────────────────────────────────────────────────────────────────────────────

# SQLite database URL for Prisma (schema: prisma/schema.prisma).
# Relative paths resolve from prisma/ — file:../db/custom.db lands at
# db/custom.db in the repo root. The app's db.ts normalizes this for the
# standalone runtime (which chdirs to .next/standalone). Absolute file: URLs
# also work (e.g. in containers).
DATABASE_URL=file:../db/custom.db

# Canonical site URL for SEO (metadataBase, OG, sitemap, robots).
# Live deploy: https://car-care.jesspete.shop
# Original source (reference): https://wecarecarcare.com
NEXT_PUBLIC_SITE_URL=https://car-care.jesspete.shop
SITE_URL=https://car-care.jesspete.shop
