# ─────────────────────────────────────────────────────────────────────────────
# We Care Car Care (car-care) — environment template
#
# Copy to `.env` and adjust:   cp .env.example .env
#
# This file is the single source of truth for which environment variables the
# app reads. Keep it in sync with `src/lib/` whenever a variable is added.
# Never put secrets in this file — it is committed to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# SQLite database URL used by Prisma (schema: prisma/schema.prisma).
#
# Relative paths resolve from the prisma/ directory (both in the prisma CLI
# and in the generated client runtime), so the recommended value below lands
# at db/custom.db in the repo root:
#
#   `bunx prisma db push`      creates/syncs db/custom.db from the schema
#   `bun run dev` / `start`    read the same file at runtime
#
# An absolute file: URL also works (e.g. in containers or standalone deploys
# where you want an unambiguous path) — the sandbox dev box currently uses one.
DATABASE_URL=file:../db/custom.db
